#!/bin/bash
# Serve a persistent counter on the given port for the acceptance tests.
# Needs the GemStone environment, as set up by Jasper's "Open Terminal".
exec "$GEMSTONE/bin/topaz" -lq <<TOPAZ
set user DataCurator pass ${TIDEWATER_STONE_PASSWORD:-swordfish} gemstone ${TIDEWATER_STONE:-gs64stone}
login
run
UserGlobals at: #TidewaterAcceptanceCounter put: TwCounter new.
System commitTransaction.
(TwApp on: (TwCounterView on: (UserGlobals at: #TidewaterAcceptanceCounter))) serveOn: $1
%
TOPAZ
